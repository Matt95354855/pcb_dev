            "kind": "power",
            "direction": "output",
            "voltage_min": 4.75,
            "voltage_max": 5.25,
            "polarity": "positive",
            "max_current_ma": 500
          },
          {
            "id": "gnd",
            "kind": "ground",
            "direction": "passive"
          }
        ],
        "components": [
          {
            "id": "connector",
            "reference": "J1",
            "value": "USB-C power only",
            "footprint": "Connector_USB:USB_C_Receptacle_USB2.0_16P",
            "pins": {
              "A1": "GND",
              "A4": "VBUS",
              "A5": "CC1",
              "B1": "GND",
              "B4": "VBUS",
              "B5": "CC2"
            },
            "parameters": {},
            "position": {
              "x_mm": 5,
              "y_mm": 15,
              "side": "top",
              "rotation": 0
            }
          },
          {
            "id": "cc1",
            "reference": "R1",
            "value": "5.1k",
            "footprint": "Resistor_SMD:R_0603_1608Metric",
            "pins": {
              "1": "CC1",
              "2": "GND"
            },
            "parameters": {},
            "position": {
              "x_mm": 10,
              "y_mm": 11,
              "side": "top",
              "rotation": 0
            }
          },
          {
            "id": "cc2",
            "reference": "R2",
            "value": "5.1k",
            "footprint": "Resistor_SMD:R_0603_1608Metric",
