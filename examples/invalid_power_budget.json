              "1": "CC2",
              "2": "GND"
            },
            "parameters": {},
            "position": {
              "x_mm": 10,
              "y_mm": 19,
              "side": "top",
              "rotation": 0
            }
          }
        ]
      },
      {
        "id": "power",
        "description": "3.3 V linear-regulator functional block; choose and qualify a real regulator.",
        "depends_on": [
          "board.usb"
        ],
        "parameters": {
          "load_a": 0.09,
          "max_dissipation_w": 0.5
        },
        "equations": {
          "dissipation_w": "(input_v - logic_v) * load_a"
        },
        "constraints": [
          {
            "expression": "dissipation_w < max_dissipation_w",
            "message": "Regulator dissipation exceeds planning limit"
          }
        ],
        "ports": [
          {
            "id": "vin",
            "kind": "power",
            "direction": "input",
            "voltage_min": 4.5,
            "voltage_max": 5.5,
            "polarity": "positive",
            "current_draw_ma": 100
          },
          {
            "id": "vout",
            "kind": "power",
            "direction": "output",
            "voltage_min": 3.25,
            "voltage_max": 3.35,
            "polarity": "positive",
            "max_current_ma": 50
          },
          {
            "id": "gnd",
            "kind": "ground",
            "direction": "passive"
          }
        ],
        "components": [
          {
            "id": "regulator",
            "reference": "U1",
            "value": "LDO_3V3_DEMO",
