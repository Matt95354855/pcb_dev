{
  "schema_version": 1,
  "name": "USB-C → 3.3 V · MCU + LED",
  "version": "0.1.0",
  "board": {
    "width_mm": 40,
    "height_mm": 30,
    "layers": 2,
    "manufacturer": "jlcpcb"
  },
  "root": {
    "id": "board",
    "description": "Nested block architecture demonstration. All library identities are unqualified.",
    "parameters": {
      "input_v": 5.0,
      "logic_v": 3.3
    },
    "children": [
      {
        "id": "usb",
        "description": "USB-C power-only interface. Generic preview, CC pull-downs shown.",
