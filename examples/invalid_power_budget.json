    },
    {
      "source": "board.usb.gnd",
      "target": "board.power.gnd",
      "net": "GND"
    },
    {
      "source": "board.usb.gnd",
      "target": "board.mcu.gnd",
      "net": "GND"
    },
    {
      "source": "board.usb.gnd",
      "target": "board.led.gnd",
      "net": "GND"
    },
    {
      "source": "board.mcu.gpio",
      "target": "board.led.control",
      "net": "LED_GPIO"
    }
  ],
  "metadata": {
