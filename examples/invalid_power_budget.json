            "pins": {
              "1": "VBUS",
              "2": "GND"
            },
            "parameters": {
              "voltage_rating_v": 10,
              "applied_voltage_v": 5.25,
              "derating_factor": 0.8
            },
            "position": {
              "x_mm": 14,
              "y_mm": 10,
              "side": "top",
              "rotation": 0
            }
          },
          {
            "id": "output_cap",
            "reference": "C2",
            "value": "10u",
            "footprint": "Capacitor_SMD:C_0805_2012Metric",
            "pins": {
              "1": "3V3",
              "2": "GND"
            },
            "parameters": {
              "voltage_rating_v": 10,
              "applied_voltage_v": 3.35,
              "derating_factor": 0.8
            },
            "position": {
              "x_mm": 20,
              "y_mm": 10,
              "side": "top",
              "rotation": 0
            }
          }
        ]
      },
      {
        "id": "mcu",
        "description": "Generic MCU functional interface and local bypass capacitor. Not a real pinout.",
        "depends_on": [
          "board.power"
        ],
        "ports": [
          {
            "id": "vcc",
            "kind": "power",
            "direction": "input",
            "voltage_min": 3.0,
            "voltage_max": 3.6,
            "polarity": "positive",
            "current_draw_ma": 80
          },
          {
            "id": "gnd",
            "kind": "ground",
            "direction": "passive"
          },
          {
            "id": "gpio",
            "kind": "digital",
            "direction": "output",
            "voltage_min": 0,
            "voltage_max": 3.35,
            "logic_standard": "3v3"
          }
        ],
        "components": [
          {
            "id": "device",
            "reference": "U2",
            "value": "MCU_DEMO",
            "footprint": "Package_DFN_QFN:QFN-32-1EP_5x5mm_P0.5mm_EP3.1x3.1mm",
            "pins": {
              "1": "3V3",
              "2": "GND",
              "3": "LED_GPIO"
            },
            "parameters": {},
            "position": {
              "x_mm": 28,
              "y_mm": 15,
              "side": "top",
              "rotation": 0
            }
          },
          {
            "id": "bypass",
            "reference": "C3",
            "value": "100n",
            "footprint": "Capacitor_SMD:C_0603_1608Metric",
            "pins": {
              "1": "3V3",
              "2": "GND"
            },
            "parameters": {
              "voltage_rating_v": 10,
              "applied_voltage_v": 3.35,
              "derating_factor": 0.8
            },
            "position": {
              "x_mm": 25,
              "y_mm": 10,
              "side": "top",
              "rotation": 0
            }
          }
        ]
      },
      {
        "id": "led",
        "description": "Indicator LED with a current limiting resistor.",
        "depends_on": [
          "board.power",
          "board.mcu"
        ],
        "parameters": {
          "led_forward_v": 2.0,
          "led_current_a": 0.004
        },
        "equations": {
          "series_resistance_ohm": "(logic_v - led_forward_v) / led_current_a"
        },
        "constraints": [
          {
            "expression": "series_resistance_ohm > 0",
            "message": "Supply must exceed the LED forward voltage"
          }
        ],
        "ports": [
          {
            "id": "vcc",
            "kind": "power",
            "direction": "input",
            "voltage_min": 3.0,
            "voltage_max": 3.6,
            "polarity": "positive",
            "current_draw_ma": 10
          },
          {
            "id": "gnd",
            "kind": "ground",
            "direction": "passive"
          },
          {
            "id": "control",
            "kind": "digital",
            "direction": "input",
            "voltage_min": 0,
            "voltage_max": 3.6,
            "logic_standard": "3v3"
          }
        ],
        "components": [
          {
            "id": "series",
            "reference": "R3",
            "value": "330",
            "footprint": "Resistor_SMD:R_0603_1608Metric",
            "pins": {
              "1": "LED_GPIO",
              "2": "LED_ANODE"
            },
            "parameters": {
              "power_rating_w": 0.1,
              "power_dissipation_w": 0.006
            },
            "position": {
              "x_mm": 33,
              "y_mm": 12,
              "side": "top",
              "rotation": 0
            }
          },
          {
            "id": "indicator",
            "reference": "D1",
            "value": "LED_RED_DEMO",
            "footprint": "LED_SMD:LED_0603_1608Metric",
            "pins": {
              "1": "GND",
              "2": "LED_ANODE"
            },
            "parameters": {},
            "position": {
              "x_mm": 35,
              "y_mm": 18,
              "side": "top",
              "rotation": 0
            }
          }
        ]
      }
    ]
  },
  "connections": [
